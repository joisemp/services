# ─────────────────────────────────────────────────────────────────────────────
# Environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Product ───────────────────────────────────────────────────────────────────
PROJECT_NAME=Services API

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-me-in-production
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (local Docker) ───────────────────────────────────────────────────
POSTGRES_DB=services
POSTGRES_USER=services
POSTGRES_PASSWORD=services
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Database (production — Railway injects this; do not set POSTGRES_* ) ──────
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Refresh cookie ────────────────────────────────────────────────────────────
REFRESH_COOKIE_NAME=services_refresh
# REFRESH_COOKIE_SAMESITE=Lax

# ── Email (dev: Mailpit at http://localhost:8025) ─────────────────────────────
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# ── Email (prod: fill these in for production SMTP) ───────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── Frontend URL ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# Optional dedicated HMAC key for JWTs. If unset, SECRET_KEY is used.
# JWT_SIGNING_KEY=

# ── CSRF (production) ─────────────────────────────────────────────────────────
# CSRF_TRUSTED_ORIGINS=https://example.com

# ── Object storage (required when ENVIRONMENT != development) ───────────────────
# DigitalOcean Spaces / S3 — must be real values on Railway or collectstatic fails.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://your-space.region.digitaloceanspaces.com
# AWS_S3_CUSTOM_DOMAIN=your-space.region.digitaloceanspaces.com
