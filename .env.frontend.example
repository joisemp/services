# ─────────────────────────────────────────────────────────────────────────────
# Frontend developer env
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file in TWO places in the React project:
#
#   .env      — Compose reads API_IMAGE (and optional POSTGRES_*) from here.
#               Must sit next to docker-compose.frontend-dev.yml.
#
#   .env.api  — Passed into the API container (Django). Do not rely on this
#               file to set the image name.
#
# ─────────────────────────────────────────────────────────────────────────────

# Compose interpolates this from .env (not from .env.api):
API_IMAGE=ghcr.io/joisemp/services:dev

PROJECT_NAME=Services API

SECRET_KEY=frontend-dev-secret-not-for-production
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=services
POSTGRES_USER=services
POSTGRES_PASSWORD=services
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

REFRESH_COOKIE_NAME=services_refresh
# REFRESH_COOKIE_SAMESITE=Lax

DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False

FRONTEND_URL=http://localhost:5173

# Optional dedicated HMAC key for JWTs. If unset, SECRET_KEY is used.
# JWT_SIGNING_KEY=
